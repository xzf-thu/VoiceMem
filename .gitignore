# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
# 本地草稿测试不进仓库，但按 README 两节写的那两个装包自检要进
tests/*
!tests/test_offline_engine.py
!tests/test_streaming.py
!tests/test_demo_from_zero.py
!tests/test_session_context.py

# 运行时数据：记忆库、评测结果、录音归档
results/
/rtc_gateway/voicemem-rtc
memory/
out/

# 环境与本地配置
.env
.venv/
.claude/
.DS_Store

# 模型权重：由 scripts/download_models.sh 拉取，不进仓库
*.onnx
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
# models/ 下的内容由下载脚本或运行时缓存生成，不进仓库
/models/

# 本地演示分叉与个人种子脚本
demo_local/
scripts/seed_*.py

# Electron 桌面壳
node_modules/

# 默认记忆根目录（不传 memory_root 时落在当前目录）
voicemem_memory/
examples/example_memory/
# 记忆空间：**目录结构**进仓库，里面的数据不进。
# clone 下来是两个空文件夹——demo（跑 demo 用）和 myvoicemem（你自己的），
# 谁跑谁自己积累，不把任何人的记忆推上去。
# Memory Space：只提交空目录，**任何记忆内容都不进仓库**。
# 一种语言一个空间（demo-zh / demo-en）——检索是按向量做的，中英混在一个库里
# 会让一半记忆检索不到。demo 启动时按语言落到对应空间，右上角切语言就换库。
voicemem_memoryspace/*
!voicemem_memoryspace/demo-zh/
!voicemem_memoryspace/demo-en/
!voicemem_memoryspace/myvoicemem/
voicemem_memoryspace/demo-zh/*
voicemem_memoryspace/demo-en/*
voicemem_memoryspace/myvoicemem/*
!voicemem_memoryspace/demo-zh/.gitkeep
!voicemem_memoryspace/demo-en/.gitkeep
!voicemem_memoryspace/myvoicemem/.gitkeep
